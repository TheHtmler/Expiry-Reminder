.editor {
  padding: 22rpx 24rpx 28rpx;
  border: 1rpx solid #d7e2da;
  border-radius: 16rpx;
  background: #fff;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.color-label {
  margin-top: 22rpx;
}

.colors {
  align-items: center;
}

.category-heading {
  margin-top: 34rpx;
}

.category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.actions {
  display: flex;
  align-items: center;
  flex: none;
  gap: 8rpx;
}
