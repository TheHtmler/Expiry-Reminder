.scan-result-page {
  padding-bottom: 48rpx;
}

.result-card {
  margin-top: 12rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid rgba(47, 143, 98, 0.12);
}

.result-kicker {
  display: block;
  color: #2f8f62;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.result-name {
  display: block;
  margin-top: 12rpx;
  color: #1c2b24;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.result-meta {
  display: block;
  margin-top: 10rpx;
  color: #5c6b63;
  font-size: 26rpx;
  line-height: 1.4;
}

.result-hint {
  display: block;
  margin-top: 20rpx;
  color: #6b7870;
  font-size: 24rpx;
  line-height: 1.5;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}
