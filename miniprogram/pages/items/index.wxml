<view class="page items-page">
  <view class="page-heading"><text class="page-title">物品</text><text class="page-subtitle">{{items.length}} 件记录</text></view>
  <view class="toolbar">
    <view class="search-box"><image src="/assets/ui/search.png" mode="aspectFit" /><input class="search" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索名称、品牌或条码" /></view>
    <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onStatusChange"><view class="filter">{{statusLabels[statusIndex]}}⌄</view></picker>
  </view>
  <view class="filter-row">
    <picker mode="selector" range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view class="filter-chip">{{categoryLabels[categoryIndex]}}⌄</view></picker>
    <picker mode="selector" range="{{locationLabels}}" value="{{locationIndex}}" bindchange="onLocationChange"><view class="filter-chip">{{locationLabels[locationIndex]}}⌄</view></picker>
  </view>
  <view class="list-header"><text>按最早日期排序</text><view class="header-actions"><button wx:if="{{isAdmin}}" class="text-button" bindtap="toggleBulkMode">{{bulkMode ? '取消批量' : '批量移动'}}</button><button wx:if="{{isAdmin}}" class="text-button" bindtap="openRecycleBin">最近删除</button></view></view>
  <view wx:if="{{error}}" class="error-state"><text>{{error}}</text><button bindtap="retry">重新连接</button></view>
  <view wx:elif="{{loading && items.length === 0}}" class="empty-state"><icon type="waiting" size="32" color="#587162" /><text class="empty-title">正在加载</text></view>
  <view wx:elif="{{items.length === 0}}" class="empty-state"><image class="empty-icon" src="/assets/tabbar/package-active.png" mode="aspectFit" /><text class="empty-title">还没有物品</text><text class="empty-copy">先记录一件需要关注日期的物品</text><button class="empty-action primary" bindtap="openForm">添加物品</button></view>
  <block wx:if="{{bulkMode}}">
    <checkbox-group bindchange="onSelectionChange">
      <label wx:for="{{items}}" wx:key="id" class="select-row"><checkbox value="{{item.id}}" color="#D85F42" /><text>{{item.name}}</text><text>{{item.nearestEventDate}}</text></label>
    </checkbox-group>
  </block>
  <block wx:else>
    <item-card wx:for="{{items}}" wx:key="id" item="{{item}}" bind:open="openItem" bind:quantitychange="onQuantityChange" bind:process="onProcess" />
  </block>
  <view wx:if="{{bulkMode}}" class="bulk-bar"><picker mode="selector" range="{{categories}}" range-key="name" value="{{targetCategoryIndex}}" bindchange="onTargetCategoryChange"><view class="bulk-target">{{categories.length > targetCategoryIndex ? categories[targetCategoryIndex].name : '目标分类'}}⌄</view></picker><button loading="{{moving}}" disabled="{{moving || selectedIds.length === 0}}" bindtap="moveSelected">移动 {{selectedIds.length}} 项</button></view>
  <button class="add-fab" bindtap="openForm" aria-label="手动添加物品"><image src="/assets/ui/plus-white.png" mode="aspectFit" /></button>
</view>
