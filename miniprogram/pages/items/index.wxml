<view class="page items-page {{bulkMode ? 'page-with-bulk' : 'page-with-fab'}}">
  <view class="page-heading">
    <view class="page-heading-main">
      <text class="page-title">物品</text>
      <text class="page-subtitle">{{loading && items.length === 0 ? '加载中…' : items.length + ' 件记录'}}</text>
    </view>
  </view>
  <view class="toolbar">
    <view class="search-box">
      <image src="/assets/ui/search.png" mode="aspectFit" />
      <input class="search" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索名称、品牌或条码" />
    </view>
    <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="filter"><text class="filter-text">{{statusLabels[statusIndex]}}</text><text class="picker-caret">⌄</text></view>
    </picker>
  </view>
  <view class="filter-row">
    <picker mode="selector" range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="filter-chip"><text class="filter-text">{{categoryLabels[categoryIndex]}}</text><text class="picker-caret">⌄</text></view>
    </picker>
    <picker mode="selector" range="{{locationLabels}}" value="{{locationIndex}}" bindchange="onLocationChange">
      <view class="filter-chip"><text class="filter-text">{{locationLabels[locationIndex]}}</text><text class="picker-caret">⌄</text></view>
    </picker>
  </view>
  <view class="list-header">
    <text class="list-header-label">按最早日期排序</text>
    <view class="header-actions">
      <view wx:if="{{isAdmin}}" class="text-button" hover-class="btn-hover" bindtap="toggleBulkMode">{{bulkMode ? '取消批量' : '批量移动'}}</view>
      <view wx:if="{{isAdmin}}" class="text-button" hover-class="btn-hover" bindtap="openRecycleBin">最近删除</view>
    </view>
  </view>

  <view wx:if="{{loading || refreshing}}" class="page-refresh-bar">
    <view class="page-refresh-dot"></view>
    <text>{{loading && items.length === 0 ? '正在加载物品列表…' : '正在刷新列表…'}}</text>
  </view>

  <view wx:if="{{error}}" class="error-state">
    <text>{{error}}</text>
    <view class="error-retry" hover-class="btn-hover" bindtap="retry">重新连接</view>
  </view>

  <view wx:elif="{{loading && items.length === 0}}" class="page-loading">
    <view class="page-loading-spinner"></view>
    <text class="page-loading-title">正在加载物品</text>
    <text class="page-loading-copy">请稍候，正在拉取家庭物品</text>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <image class="empty-icon" src="/assets/tabbar/package-active.png" mode="aspectFit" />
    <text class="empty-title">还没有物品</text>
    <text class="empty-copy">先记录一件需要关注日期的物品</text>
    <view class="empty-action primary" hover-class="btn-hover" bindtap="openForm">添加物品</view>
  </view>

  <block wx:else>
    <checkbox-group wx:if="{{bulkMode}}" bindchange="onSelectionChange">
      <label wx:for="{{items}}" wx:key="id" class="select-row">
        <checkbox value="{{item.id}}" color="#2F8F62" />
        <text class="select-name">{{item.name}}</text>
        <text class="select-date">{{item.nearestEventDate}}</text>
      </label>
    </checkbox-group>
    <block wx:else>
      <item-card
        wx:for="{{items}}"
        wx:key="id"
        item="{{item}}"
        bind:open="openItem"
        bind:updated="onItemUpdated"
      />
    </block>
  </block>

  <view wx:if="{{bulkMode}}" class="bulk-bar">
    <picker mode="selector" range="{{categories}}" range-key="name" value="{{targetCategoryIndex}}" bindchange="onTargetCategoryChange">
      <view class="bulk-target">
        <text class="filter-text">{{categories.length > targetCategoryIndex ? categories[targetCategoryIndex].name : '目标分类'}}</text>
        <text class="picker-caret">⌄</text>
      </view>
    </picker>
    <button class="bulk-submit" loading="{{moving}}" disabled="{{moving || selectedIds.length === 0}}" bindtap="moveSelected">
      移动 {{selectedIds.length}} 项
    </button>
  </view>
  <view wx:if="{{!bulkMode}}" class="add-fab" hover-class="add-fab-hover" bindtap="openForm" aria-label="手动添加物品">
    <image src="/assets/ui/plus-white.png" mode="aspectFit" />
  </view>
</view>
