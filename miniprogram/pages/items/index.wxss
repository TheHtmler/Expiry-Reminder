.toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180rpx;
  gap: 14rpx;
  align-items: stretch;
}

.search-box {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #c8d5cd;
  border-radius: 14rpx;
  background: #fff;
}

.search-box image {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  opacity: 0.72;
}

.search {
  min-width: 0;
  flex: 1;
  height: 78rpx;
  font-size: 26rpx;
  line-height: 78rpx;
}

.filter,
.filter-chip,
.bulk-target {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-width: 0;
  height: 80rpx;
  padding: 0 16rpx;
  border: 1rpx solid #c8d5cd;
  border-radius: 14rpx;
  background: #fff;
  color: #3d4d44;
  font-size: 24rpx;
  line-height: 1;
}

.filter-chip {
  height: 64rpx;
  border-radius: 999rpx;
  color: #54685b;
}

.filter-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 80rpx;
  margin-top: 8rpx;
}

.list-header-label {
  flex: none;
  color: #54685b;
  font-size: 24rpx;
  line-height: 1.4;
}

.header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 4rpx;
  min-width: 0;
}

.select-row {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #d7e2da;
}

.select-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-date {
  flex: none;
  color: #6b7870;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.page-with-bulk {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.bulk-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 12;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 16rpx;
  align-items: center;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d7e2da;
  background: #fff;
}
