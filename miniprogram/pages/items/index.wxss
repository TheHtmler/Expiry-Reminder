.items-page { padding-bottom: 140rpx; }
.toolbar { display: grid; grid-template-columns: minmax(0, 1fr) 180rpx; gap: 14rpx; }
.search-box { display: flex; align-items: center; box-sizing: border-box; height: 80rpx; padding: 0 18rpx; border: 1rpx solid #cbd1c9; border-radius: 8rpx; background: #fff; }
.search-box image { flex: none; width: 34rpx; height: 34rpx; margin-right: 10rpx; opacity: .68; }
.search { min-width: 0; height: 78rpx; flex: 1; font-size: 26rpx; }
.filter { box-sizing: border-box; height: 80rpx; padding: 18rpx 16rpx; border: 1rpx solid #cbd1c9; border-radius: 8rpx; background: #fff; font-size: 25rpx; }
.filter { text-align: center; }
.filter-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.filter-chip { padding: 12rpx 18rpx; border: 1rpx solid #dfe3dd; border-radius: 8rpx; background: #fff; color: #596159; font-size: 24rpx; }
.list-header { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; color: #596159; font-size: 26rpx; }
.header-actions { display: flex; align-items: center; }
.text-button { width: auto; margin: 0; padding: 0 12rpx; background: transparent; color: #b94c36; font-size: 25rpx; }
.text-button::after { border: 0; }
.select-row { display: grid; grid-template-columns: 48rpx minmax(0, 1fr) auto; align-items: center; gap: 16rpx; min-height: 88rpx; border-bottom: 1rpx solid #dfe3dd; }
.select-row text:last-child { color: #747b74; font-size: 24rpx; }
.bulk-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 12; display: grid; grid-template-columns: 1fr 240rpx; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dfe3dd; background: #fff; }
.bulk-target { box-sizing: border-box; height: 80rpx; padding: 20rpx; border: 1rpx solid #cbd1c9; border-radius: 8rpx; font-size: 26rpx; }
.bulk-bar button { margin: 0; background: #d85f42; color: #fff; font-size: 26rpx; }
.add-fab { position: fixed; right: 34rpx; bottom: 150rpx; z-index: 10; display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; margin: 0; padding: 0; border-radius: 50%; background: #d9523b; box-shadow: 0 10rpx 24rpx rgba(80, 42, 32, .22); }
.add-fab image { width: 46rpx; height: 46rpx; }
.add-fab::after { border: 0; }
