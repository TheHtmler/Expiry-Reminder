.family-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #d7e2da;
  border-radius: 16rpx;
  background: #fff;
}

.family-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #e3f2ea;
}

.family-mark image {
  width: 40rpx;
  height: 40rpx;
}

.family-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.family-label {
  display: block;
  color: #6b7870;
  font-size: 22rpx;
  line-height: 1.3;
}

.family-main household-switcher {
  max-width: 100%;
}

.role-chip {
  flex: none;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #e3f2ea;
  color: #246b4a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.menu-section {
  margin-top: 34rpx;
}

.menu-label {
  display: block;
  margin: 0 0 12rpx 4rpx;
  color: #6b7870;
  font-size: 24rpx;
  line-height: 1.4;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
}

.menu-icon image {
  width: 30rpx;
  height: 30rpx;
}

.menu-icon.green {
  background: #e3f2ea;
}

.menu-icon.amber {
  background: #f7eadc;
}

.menu-icon.mint {
  background: #e8f4ef;
}

.menu-icon.gray {
  background: #ecefeb;
}
