.welcome {
  padding: 52rpx 0 38rpx;
  text-align: center;
}

.app-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 24rpx;
  border-radius: 22rpx;
  background: #2f8f62;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 12rpx 28rpx rgba(36, 107, 74, 0.22);
}

.welcome-title {
  display: block;
  color: #1c2b24;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.form-surface {
  margin-top: 24rpx;
  padding: 8rpx 24rpx 28rpx;
  border: 1rpx solid #d7e2da;
  border-radius: 16rpx;
  background: #fff;
}
