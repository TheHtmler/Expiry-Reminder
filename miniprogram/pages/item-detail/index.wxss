.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 0 28rpx;
}

.title-main {
  min-width: 0;
  flex: 1;
}

.status {
  display: inline-block;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #e3f2ea;
  color: #246b4a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.status-expired { background: #f6e4e1; color: #a9362b; }
.status-due_today { background: #f7eadc; color: #ad641f; }
.status-processed { background: #ecefeb; color: #606860; }

.name {
  display: block;
  margin-top: 14rpx;
  color: #1c2b24;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.meta {
  display: block;
  margin-top: 10rpx;
  color: #6b7870;
  font-size: 22rpx;
  line-height: 1.4;
}

.detail-photo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 420rpx;
  margin-bottom: 24rpx;
  padding: 12rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #eef4f0;
}

.detail-photo {
  display: block;
  width: 100%;
  height: 100%;
  background: transparent;
}

.quantity-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #d7e2da;
  border-radius: 16rpx;
  background: #fff;
}

.quantity-info {
  min-width: 0;
  flex: 1;
}

.quantity-hint {
  flex: none;
  color: #8a968e;
  font-size: 22rpx;
  line-height: 1.4;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(28, 43, 36, 0.42);
}

.sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 28rpx 28rpx 0 0;
  background: #f7faf8;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 4rpx auto 20rpx;
  border-radius: 999rpx;
  background: #c8d5cd;
}

.sheet-kicker {
  display: block;
  color: #6b7870;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.sheet-title {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  color: #1c2b24;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.section {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #d7e2da;
  border-radius: 18rpx;
  background: #fff;
}

.section-label {
  display: block;
  color: #1c2b24;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: #6b7870;
  font-size: 22rpx;
  line-height: 1.45;
}

.quantity-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.unit-label {
  color: #5c6b63;
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.action-btn.primary {
  background: #2f8f62;
  color: #fff;
}

.action-btn.danger {
  border: 1rpx solid #d7a9a3;
  background: #fff7f5;
  color: #b83a30;
}

.action-btn.ghost {
  border: 1rpx solid #c8d5cd;
  background: #fff;
  color: #3d4d44;
}

.action-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.confirm-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f7faf8;
}

.confirm-text {
  display: block;
  color: #3d4d44;
  font-size: 26rpx;
  line-height: 1.45;
}

.confirm-actions {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 12rpx;
}

.confirm-actions .action-btn {
  margin-top: 16rpx;
}

.close-btn {
  margin-top: 8rpx;
}

.btn-hover {
  opacity: 0.84;
}

.panel-label {
  display: block;
  color: #6b7870;
  font-size: 22rpx;
  line-height: 1.4;
}

.quantity-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 6rpx;
}

.quantity-number {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.unit {
  color: #6b7870;
  font-size: 24rpx;
}

.detail-section {
  margin-top: 34rpx;
}

.timeline,
.info-list {
  overflow: hidden;
  border: 1rpx solid #d7e2da;
  border-radius: 16rpx;
  background: #fff;
}

.event-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 92rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #e7efe9;
}

.event-row:last-child {
  border-bottom: 0;
}

.event-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2f8f62;
}

.event-text {
  min-width: 0;
  flex: 1;
}

.event-type {
  display: block;
  color: #6b7870;
  font-size: 22rpx;
  line-height: 1.4;
}

.event-date {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 82rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #e7efe9;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex: none;
  color: #6b7870;
  font-size: 26rpx;
  line-height: 1.4;
}

.info-value {
  min-width: 0;
  flex: 1;
  color: #1c2b24;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: right;
  overflow-wrap: anywhere;
}
