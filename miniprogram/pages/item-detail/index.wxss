.detail-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 14rpx 0 28rpx; }.title-main { min-width: 0; }.name { display: block; margin-top: 14rpx; font-size: 42rpx; font-weight: 750; overflow-wrap: anywhere; }.meta { display: block; margin-top: 10rpx; color: #747b74; font-size: 23rpx; }.status { display: inline-block; padding: 6rpx 12rpx; border-radius: 6rpx; background: #e4ede4; color: #3f684f; font-size: 22rpx; }.status-expired { background: #f6e4e1; color: #a9362b; }.status-due_today { background: #f7eadc; color: #ad641f; }.status-processed { background: #ecefeb; color: #606860; }
.edit-button { width: 112rpx; margin: 0; border: 1rpx solid #cbd2c8; background: #fff; font-size: 25rpx; }.edit-button::after { border: 0; }
.quantity-panel { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 24rpx; border: 1rpx solid #dce1da; border-radius: 8rpx; background: #fff; }.panel-label { display: block; color: #697169; font-size: 23rpx; }.quantity-number { margin-right: 8rpx; font-size: 40rpx; font-weight: 750; }.unit { color: #747b74; font-size: 24rpx; }
.detail-section { margin-top: 34rpx; }.timeline, .info-list { overflow: hidden; border: 1rpx solid #dce1da; border-radius: 8rpx; background: #fff; }.event-row { position: relative; display: flex; align-items: center; gap: 18rpx; min-height: 92rpx; padding: 0 24rpx; border-bottom: 1rpx solid #e8ebe6; }.event-row:last-child { border-bottom: 0; }.event-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d85f42; }.event-type { display: block; color: #697169; font-size: 23rpx; }.event-date { display: block; margin-top: 3rpx; font-size: 28rpx; font-weight: 650; }
.info-list view { display: flex; justify-content: space-between; gap: 24rpx; min-height: 82rpx; padding: 20rpx 24rpx; border-bottom: 1rpx solid #e8ebe6; color: #697169; font-size: 26rpx; }.info-list view:last-child { border-bottom: 0; }.info-list text:last-child { color: #202520; text-align: right; overflow-wrap: anywhere; }.danger-action { margin-top: 18rpx; background: transparent; color: #b53c2d; font-size: 26rpx; }
