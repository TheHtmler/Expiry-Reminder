<view class="page">
  <view class="page-heading">
    <view class="page-heading-main">
      <text class="page-title">家庭设置</text>
      <text class="page-subtitle">{{name}}</text>
    </view>
  </view>
  <view wx:if="{{!isAdmin}}" class="empty-state"><view class="empty-mark">锁</view><text class="empty-title">仅管理员可以修改</text></view>
  <block wx:else>
    <view class="form-surface">
      <view class="field"><text class="field-label">家庭名称</text><input class="input" value="{{name}}" bindinput="onNameInput" maxlength="24" /></view>
      <view class="field"><text class="field-label">时区</text><input class="input" value="{{timezone}}" bindinput="onTimezoneInput" /></view>
      <view class="field">
        <text class="field-label">每日提醒时间</text>
        <picker range="{{hourLabels}}" value="{{reminderHour}}" bindchange="onHourChange">
          <view class="input picker-value"><text class="picker-text">{{hourLabels[reminderHour]}}</text><text class="picker-caret">⌄</text></view>
        </picker>
      </view>
      <button class="primary-button" loading="{{saving}}" bindtap="onSave">保存设置</button>
    </view>
    <view class="settings-section">
      <view class="section-heading"><text>管理员权限</text></view>
      <picker range="{{members}}" range-key="userId" value="{{targetIndex}}" bindchange="onTargetChange">
        <view class="input picker-value"><text class="picker-text">{{targetIndex >= 0 ? '已选择家庭成员' : '选择接任成员'}}</text><text class="picker-caret">⌄</text></view>
      </picker>
      <button class="secondary-button" bindtap="onTransfer">转让管理员</button>
    </view>
    <view class="settings-section danger-zone"><view class="section-heading"><text>危险操作</text></view><button class="secondary-button danger-button" bindtap="onDissolve">解散家庭</button></view>
  </block>
</view>
