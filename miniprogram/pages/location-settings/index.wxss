.editor {
  padding: 22rpx 24rpx 28rpx;
  border: 1rpx solid #d7e2da;
  border-radius: 16rpx;
  background: #fff;
}

.location-heading {
  margin-top: 34rpx;
}

.location-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #e3f2ea;
  color: #246b4a;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.actions {
  display: flex;
  align-items: center;
  flex: none;
  gap: 8rpx;
}
