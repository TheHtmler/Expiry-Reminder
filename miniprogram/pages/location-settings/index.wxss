.editor { padding: 22rpx 24rpx 28rpx; border: 1rpx solid #dce1da; border-radius: 8rpx; background: #fff; }.location-heading { margin-top: 34rpx; }.location { min-height: 112rpx; }.location-main { display: flex; align-items: center; gap: 18rpx; }.location-mark { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 8rpx; background: #e4ede4; color: #3f684f; font-size: 22rpx; font-weight: 700; }
.actions { display: flex; align-items: center; gap: 8rpx; }.actions button { width: 52rpx; min-width: 52rpx; height: 52rpx; margin: 0; padding: 0; background: #f7f8f6; line-height: 48rpx; }
