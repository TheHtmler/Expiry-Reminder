<view class="page">
  <view class="page-heading">
    <view class="page-heading-main">
      <text class="page-title">位置管理</text>
      <text class="page-subtitle">{{locations.length}} 个存放位置</text>
    </view>
  </view>
  <view wx:if="{{isAdmin}}" class="editor">
    <view class="section-heading"><text>新增位置</text></view>
    <view class="field"><text class="field-label">位置名称</text><input class="input" value="{{name}}" bindinput="onNameInput" maxlength="12" placeholder="例如：冰箱" /></view>
    <button class="primary-button" bindtap="onCreate">新增位置</button>
  </view>
  <view wx:if="{{locations.length === 0}}" class="empty-state"><view class="empty-mark">位</view><text class="empty-title">暂无存放位置</text></view>
  <view class="section-heading location-heading" wx:if="{{locations.length > 0}}"><text>现有位置</text><text class="section-caption">显示与排序</text></view>
  <view class="list-surface" wx:if="{{locations.length > 0}}">
    <view wx:for="{{locations}}" wx:key="id" class="location list-row">
      <view class="row-main">
        <view class="location-mark">位</view>
        <view class="row-text">
          <text class="row-title">{{item.name}}</text>
          <text class="row-meta">{{item.hidden ? '已隐藏' : '显示中'}}</text>
        </view>
      </view>
      <view wx:if="{{isAdmin}}" class="actions">
        <view class="icon-button" data-index="{{index}}" data-offset="-1" hover-class="btn-hover" bindtap="onMove" aria-label="上移">↑</view>
        <view class="icon-button" data-index="{{index}}" data-offset="1" hover-class="btn-hover" bindtap="onMove" aria-label="下移">↓</view>
        <switch checked="{{!item.hidden}}" color="#2F8F62" data-index="{{index}}" bindchange="onToggle" aria-label="显示位置" />
      </view>
      <text wx:else class="muted">{{item.hidden ? '已隐藏' : '显示中'}}</text>
    </view>
  </view>
</view>
