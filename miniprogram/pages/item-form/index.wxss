.form-page {
  padding: 0 0 calc(140rpx + env(safe-area-inset-bottom));
  background: #f2f6f3;
  color: #1c2b24;
}

.form-heading {
  padding: 28rpx 32rpx 18rpx;
  background: #f2f6f3;
}

.form-error {
  padding: 0 32rpx 20rpx;
  background: #f2f6f3;
}

.form-section {
  margin-bottom: 14rpx;
  padding: 24rpx 32rpx 12rpx;
  border-top: 1rpx solid #d7e2da;
  border-bottom: 1rpx solid #d7e2da;
  background: #fff;
}

.photo-field {
  box-sizing: border-box;
  width: 100%;
  min-height: 200rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  border: 2rpx dashed #c8d5cd;
  border-radius: 16rpx;
  background: #f7faf8;
}

.photo-empty,
.photo-filled {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 200rpx;
}

.photo-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  max-height: 420rpx;
  padding: 16rpx;
  background: #eef4f0;
}

.photo-preview {
  display: block;
  width: 100%;
  height: 360rpx;
  background: transparent;
}

.photo-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  width: 100%;
  min-height: 72rpx;
  background: #fff;
}

.photo-action {
  color: #246b4a;
  font-size: 24rpx;
  font-weight: 600;
}

.photo-action.danger {
  color: #b83a30;
}

.photo-plus {
  color: #2f8f62;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.photo-hint {
  margin-top: 12rpx;
  color: #6b7870;
  font-size: 24rpx;
}

.category-field .picker-value.compact {
  min-height: 72rpx;
  height: 72rpx;
}

.grid-two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.textarea {
  display: block;
  height: auto;
  min-height: 160rpx;
  padding: 20rpx 22rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.error {
  display: block;
  margin-top: 8rpx;
  color: #b83a30;
  font-size: 22rpx;
  line-height: 1.4;
}

.form-error-text {
  margin: 0 32rpx;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 12;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d7e2da;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(28, 58, 42, 0.06);
}

.save-bar .primary-button {
  margin: 0;
}
