.form-page { padding: 0 0 164rpx; background: #f1f2ef; }
.form-heading { padding: 28rpx 32rpx 26rpx; background: #f5f5f2; }
.form-error { padding: 0 32rpx 20rpx; background: #f5f5f2; }
.form-section { margin-bottom: 14rpx; padding: 28rpx 32rpx 20rpx; border-top: 1rpx solid #e1e4df; border-bottom: 1rpx solid #e1e4df; background: #fff; }
.form-section .section-heading { margin-bottom: 8rpx; }
.form-section .section-heading text:first-child { font-size: 32rpx; font-weight: 700; }
.grid-two { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.picker-value { display: flex; justify-content: space-between; color: #424942; }.picker-value text { color: #8a928a; }
.more-button { min-height: 82rpx; margin: 0 32rpx 14rpx; border: 1rpx solid #d4d9d3; border-radius: 8rpx; background: #fff; color: #4b554e; font-size: 27rpx; }.more-button::after { border: 0; }
.more-fields { padding-top: 28rpx; }.textarea { min-height: 160rpx; }.error { display: block; margin-top: 8rpx; color: #b53c2d; font-size: 24rpx; }
.form-page > .error { margin: 0 32rpx; }
.save-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 12; padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dce1da; background: rgba(255,255,255,.98); box-shadow: 0 -8rpx 24rpx rgba(35,43,37,.06); }.save-bar .primary-button { margin: 0; }
