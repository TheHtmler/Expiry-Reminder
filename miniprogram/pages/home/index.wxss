.home-topbar {
  padding: 10rpx 0 20rpx;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 18rpx;
}

.home-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid rgba(47, 143, 98, 0.14);
  box-sizing: border-box;
}

.home-search-hover {
  background: #f7fbf8;
}

.home-search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.home-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #1c2b24;
  font-size: 28rpx;
  line-height: 72rpx;
}

.home-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid rgba(47, 143, 98, 0.14);
  box-sizing: border-box;
}

.home-scan-hover {
  background: #f7fbf8;
}

.home-scan-icon {
  width: 36rpx;
  height: 36rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: none;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--accent);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.brand {
  display: block;
  color: #24352c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.today-intro {
  padding: 8rpx 0 6rpx;
}

.eyebrow {
  display: block;
  color: #6b7870;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.headline {
  display: block;
  max-width: 620rpx;
  margin-top: 10rpx;
  color: #1c2b24;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 36rpx 0 18rpx;
}

.section-kicker {
  display: block;
  margin-bottom: 4rpx;
  color: #6b7870;
  font-size: 22rpx;
  line-height: 1.4;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.count-label {
  flex: none;
  color: #6b7870;
  font-size: 24rpx;
  line-height: 1.4;
}

.home-empty {
  padding-top: 48rpx;
}
