.household-switcher { display: inline-flex; align-items: center; gap: 8rpx; min-height: 60rpx; max-width: 310rpx; padding: 0 16rpx; border: 1rpx solid #d5dbd3; border-radius: 8rpx; background: rgba(255,255,255,.88); }
.name { overflow: hidden; color: #3f473f; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.arrow { flex: none; color: #8a928a; font-size: 22rpx; }
