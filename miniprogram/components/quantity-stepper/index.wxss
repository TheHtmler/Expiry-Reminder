.stepper {
  display: flex;
  align-items: center;
  width: 176rpx;
}

.step {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #c8d5cd;
  border-radius: 12rpx;
  background: #ffffff;
  color: #2f6b4f;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.step.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.quantity {
  width: 64rpx;
  text-align: center;
  color: #1c2b24;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 56rpx;
  font-variant-numeric: tabular-nums;
}

.btn-hover {
  opacity: 0.82;
}
