.summary { display: grid; grid-template-columns: repeat(3, 1fr); margin: 28rpx 0 0; overflow: hidden; border-radius: 8rpx; background: #293a31; }
.summary-item { position: relative; display: flex; flex-direction: column; align-items: flex-start; padding: 24rpx 22rpx 26rpx; color: #d7e0da; font-size: 23rpx; }
.summary-item + .summary-item { border-left: 1rpx solid rgba(255,255,255,.12); }
.indicator { width: 28rpx; height: 5rpx; margin-bottom: 12rpx; border-radius: 3rpx; background: #8ea196; }
.count { margin-bottom: 4rpx; color: #fff; font-size: 40rpx; font-weight: 750; }
.expired .indicator { background: #b53c2d; }.today .indicator { background: #c96a24; }.near .indicator { background: #52724f; }
.expired .count { color: #ff9a87; }
.today .count { color: #ffc574; }
.near .count { color: #b8d7c2; }
