.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 28rpx 0 0;
  overflow: hidden;
  border-radius: 18rpx;
  background: #243f33;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 132rpx;
  padding: 22rpx 20rpx;
  color: #c5d8cc;
  font-size: 22rpx;
  line-height: 1.3;
}

.summary-item + .summary-item {
  border-left: 1rpx solid rgba(255, 255, 255, 0.1);
}

.indicator {
  width: 28rpx;
  height: 5rpx;
  margin-bottom: 12rpx;
  border-radius: 3rpx;
  background: #8fb59d;
}

.count {
  margin-bottom: 4rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.expired .indicator {
  background: #e57a6a;
}

.today .indicator {
  background: #e0b06a;
}

.near .indicator {
  background: #7dcf9f;
}

.expired .count {
  color: #ffb0a2;
}

.today .count {
  color: #ffd28a;
}

.near .count {
  color: #b8ebc8;
}
