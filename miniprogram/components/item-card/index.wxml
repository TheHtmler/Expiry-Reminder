<view class="card">
  <view class="main" bindtap="open">
    <view class="thumb-wrap">
      <image wx:if="{{item.imageFileId}}" class="thumb" src="{{item.imageFileId}}" mode="aspectFill" />
      <view wx:else class="thumb placeholder">
        <text class="thumb-mark">{{nameInitial}}</text>
      </view>
    </view>
    <view class="content">
      <view class="title-row">
        <view class="title-main">
          <view class="status-dot dot-{{item.status}}"></view>
          <text class="name">{{item.name}}</text>
        </view>
        <text class="status status-{{item.status}}">
          <block wx:if="{{item.status === 'expired'}}">已过期</block>
          <block wx:elif="{{item.status === 'due_today'}}">今日到期</block>
          <block wx:elif="{{item.status === 'near_expiry'}}">即将到期</block>
          <block wx:elif="{{item.status === 'processed'}}">不再提醒</block>
          <block wx:else>正常</block>
        </text>
      </view>
      <view class="date-row"><text class="date-label">最近日期</text><text class="date">{{item.nearestEventDate}}</text></view>
      <view class="meta-row">
        <text class="quantity-text">数量 {{item.quantity}}{{item.unit || '件'}}</text>
        <text wx:if="{{item.brand || item.specification}}" class="meta">{{item.brand}} {{item.specification}}</text>
      </view>
    </view>
  </view>
  <view class="actions">
    <view class="edit" hover-class="btn-hover" bindtap="edit">编辑</view>
    <view wx:if="{{item.status !== 'processed'}}" class="process" hover-class="btn-hover" bindtap="openUpdate">处理</view>
  </view>
</view>

<view wx:if="{{updateVisible}}" class="mask" catchtouchmove="preventMove" bindtap="closeUpdate">
  <view class="sheet" catchtap="preventMove">
    <view class="sheet-handle"></view>
    <text class="sheet-kicker">处理物品</text>
    <text class="sheet-title">{{item.name}}</text>

    <view class="section">
      <text class="section-label">剩余数量</text>
      <text class="section-desc">调整后点保存；减到 0 将不再提醒</text>
      <view class="quantity-row">
        <quantity-stepper quantity="{{draftQuantity}}" bind:change="onQuantityStep" />
        <text class="unit-label">{{item.unit || '件'}}</text>
      </view>
      <view
        class="action-btn primary {{saving || draftQuantity === item.quantity ? 'disabled' : ''}}"
        hover-class="btn-hover"
        bindtap="saveQuantity"
      >保存数量</view>
    </view>

    <view class="section">
      <text class="section-label">提醒</text>
      <text class="section-desc">关闭后，家庭成员不会再收到这件物品的到期提醒</text>
      <view wx:if="{{!confirmMute}}" class="action-btn danger" hover-class="btn-hover" bindtap="askMute">不再提醒这件物品</view>
      <view wx:else class="confirm-box">
        <text class="confirm-text">确认不再提醒「{{item.name}}」？</text>
        <view class="confirm-actions">
          <view class="action-btn ghost" hover-class="btn-hover" bindtap="cancelMute">取消</view>
          <view class="action-btn danger" hover-class="btn-hover" bindtap="confirmMuteReminders">确认不再提醒</view>
        </view>
      </view>
    </view>

    <view class="action-btn ghost close-btn" hover-class="btn-hover" bindtap="closeUpdate">关闭</view>
  </view>
</view>
