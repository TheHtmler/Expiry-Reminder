.card { margin-bottom: 18rpx; padding: 24rpx; border: 1rpx solid #dce1da; border-radius: 8rpx; background: #fff; }
.main { min-width: 0; }
.title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.title-main { display: flex; align-items: center; min-width: 0; gap: 12rpx; }
.status-dot { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; background: #66806b; }
.dot-expired { background: #b53c2d; }.dot-due_today { background: #c96a24; }.dot-near_expiry { background: #52724f; }.dot-processed { background: #9aa19a; }
.name { min-width: 0; font-size: 31rpx; font-weight: 650; overflow-wrap: anywhere; }
.status { flex: none; padding: 5rpx 10rpx; border-radius: 6rpx; background: #edf0eb; color: #596159; font-size: 22rpx; }
.status-expired { background: #f8e5e1; color: #a93428; }
.status-due_today { background: #faebdc; color: #a6541e; }
.status-near_expiry { background: #e5eee3; color: #456642; }
.date-row { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.date-label { color: #747b74; font-size: 23rpx; }.date { color: #3f473f; font-size: 27rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.meta { display: block; margin-top: 8rpx; color: #747b74; font-size: 24rpx; }
.actions { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0eb; }
.process { width: 112rpx; margin: 0; border: 1rpx solid #cbd1c9; background: #fff; color: #424942; font-size: 25rpx; }
.process::after { border: 0; }
