/* 微信 button 默认样式重置：边框/圆角在 ::after，必须一并清掉 */
button {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: auto;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  font-weight: 400;
  line-height: 1.4;
  text-align: center;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}

button::after {
  border: 0 !important;
  border-radius: 0;
}

/* —— 实心主按钮 —— */
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #2f8f62;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.primary-button::after {
  border: 0 !important;
  border-radius: 32rpx;
}

.primary-button[disabled] {
  opacity: 0.55;
}

/* —— 描边次按钮 —— */
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid #c8d5cd;
  border-radius: 16rpx;
  background: #ffffff;
  color: #3d4d44;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.secondary-button::after {
  border: 0 !important;
  border-radius: 32rpx;
}

.danger-button {
  border-color: #d7a9a3;
  color: #b83a30;
}

/* —— 文本按钮 —— */
.text-button {
  display: inline-block;
  width: auto;
  height: 56rpx;
  min-width: 0;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: transparent;
  color: #246b4a;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
  vertical-align: middle;
}

.text-button::after {
  border: 0 !important;
}

/* —— 空态按钮 —— */
.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 188rpx;
  height: 72rpx;
  margin: 28rpx auto 0;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  vertical-align: middle;
}

.empty-action::after {
  border: 0 !important;
  border-radius: 32rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 30rpx;
}

.empty-actions .empty-action {
  margin: 0;
}

.empty-action.primary {
  background: #2f8f62;
  color: #ffffff;
}

.empty-action.secondary {
  border: 1rpx solid #c8d5cd;
  background: #ffffff;
  color: #3d4d44;
}

/* —— 错误态按钮 —— */
.error-state button,
.error-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 200rpx;
  height: 68rpx;
  margin: 22rpx auto 0;
  padding: 0 24rpx;
  border: 1rpx solid #dab0aa;
  border-radius: 14rpx;
  background: #ffffff;
  color: #b83a30;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.error-state button::after,
.error-retry::after {
  border: 0 !important;
  border-radius: 28rpx;
}

/* —— 圆形 FAB（view / button 共用） —— */
.add-fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  border-radius: 50%;
  background: #2f8f62;
  box-shadow: 0 12rpx 28rpx rgba(36, 107, 74, 0.28);
  line-height: 1;
}

.add-fab::after {
  border: 0 !important;
  border-radius: 50%;
}

.add-fab image {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.add-fab:active,
.add-fab-hover {
  opacity: 0.88;
}

/* —— 分段控件（建议用 view） —— */
.segmented {
  display: flex;
  align-items: stretch;
  height: 80rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #e4ece7;
}

.segment {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #6b7870;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

.segment::after {
  border: 0 !important;
  border-radius: 24rpx;
}

.segment.active {
  background: #ffffff;
  color: #246b4a;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(36, 74, 55, 0.08);
}

/* —— 行内小按钮 / 图标按钮 —— */
.icon-button,
.mini-button,
.process,
.edit-button,
.restore,
.remove,
.step {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 1rpx solid #c8d5cd;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  vertical-align: middle;
}

.icon-button::after,
.mini-button::after,
.process::after,
.edit-button::after,
.restore::after,
.remove::after,
.step::after {
  border: 0 !important;
  border-radius: 24rpx;
}

.icon-button {
  width: 56rpx;
  height: 56rpx;
  background: #f2f6f3;
  color: #3d4d44;
  font-size: 26rpx;
  font-weight: 500;
}

.mini-button,
.process,
.edit-button,
.restore {
  width: 112rpx;
  height: 56rpx;
  color: #246b4a;
  background: #f4faf6;
  border-color: #b9d0c2;
}

.remove {
  width: 104rpx;
  height: 56rpx;
  color: #b83a30;
  background: #ffffff;
  border-color: #e3b8b1;
}

.step {
  width: 56rpx;
  height: 56rpx;
  color: #2f6b4f;
  font-size: 34rpx;
  font-weight: 400;
}

.step.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.btn-hover {
  opacity: 0.82;
}

.danger-action {
  display: block;
  width: 100%;
  height: 80rpx;
  margin-top: 18rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e3b8b1;
  border-radius: 16rpx;
  background: #ffffff;
  color: #b83a30;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 78rpx;
  text-align: center;
}

.danger-action::after {
  border: 0 !important;
  border-radius: 32rpx;
}

.more-button {
  display: block;
  width: auto;
  height: 80rpx;
  margin: 0 32rpx 14rpx;
  padding: 0 28rpx;
  border: 1rpx solid #c8d5cd;
  border-radius: 16rpx;
  background: #ffffff;
  color: #3d4d44;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 78rpx;
  text-align: center;
}

.more-button::after {
  border: 0 !important;
  border-radius: 32rpx;
}

.bulk-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #2f8f62;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.bulk-submit::after {
  border: 0 !important;
  border-radius: 32rpx;
}

.bulk-submit[disabled] {
  opacity: 0.55;
}

.choice {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #c8d5cd;
  border-radius: 14rpx;
  background: #ffffff;
  color: #3d4d44;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.choice::after {
  border: 0 !important;
  border-radius: 28rpx;
}

.choice.active {
  border-color: #2f8f62;
  background: #e3f2ea;
  color: #246b4a;
}

.color-choice {
  display: block;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  line-height: 48rpx;
}

.color-choice::after {
  border: 0 !important;
  border-radius: 50%;
}

.color-choice.active {
  box-shadow: 0 0 0 5rpx #fff, 0 0 0 8rpx #2f8f62;
}

page {
  --ink: #1c2b24;
  --muted: #6b7870;
  --line: #d7e2da;
  --surface: #ffffff;
  --canvas: #f2f6f3;
  --accent: #2f8f62;
  --accent-dark: #246b4a;
  --accent-soft: #e3f2ea;
  --green: #2f6b4f;
  --green-soft: #e4f0ea;
  --amber: #b86a1a;
  --amber-soft: #f8ead8;
  --red: #b83a30;
  --red-soft: #f7e5e2;
  --radius: 16rpx;
  --radius-sm: 12rpx;
  --control-h: 88rpx;
  --control-sm: 56rpx;
  height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.4;
  letter-spacing: 0;
  overflow-x: hidden;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
  display: none;
}

input,
textarea,
picker {
  font: inherit;
  letter-spacing: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100%;
  padding: 24rpx 32rpx 48rpx;
  overflow-x: hidden;
}

.page-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 420rpx;
  padding: 64rpx 28rpx;
  color: var(--muted);
  text-align: center;
}

.page-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #d7e8dd;
  border-top-color: #2f8f62;
  border-radius: 50%;
  animation: page-spin 0.8s linear infinite;
}

.page-loading-title {
  color: #2a3a31;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-loading-copy {
  font-size: 24rpx;
  line-height: 1.5;
}

.page-refresh-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 64rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #e8f3ec;
  color: #246b4a;
  font-size: 24rpx;
  font-weight: 600;
}

.page-refresh-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2f8f62;
  animation: page-pulse 0.9s ease-in-out infinite;
}

@keyframes page-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes page-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.page-heading {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding: 8rpx 0 28rpx;
}

.page-heading-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
  width: 100%;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.page-subtitle {
  display: block;
  margin: 0;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.section {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-heading text:first-child {
  font-size: 30rpx;
  font-weight: 600;
}

.section-caption {
  color: var(--muted);
  font-size: 24rpx;
}

.field {
  margin: 22rpx 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #4a5a51;
  font-size: 24rpx;
  font-weight: 500;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--control-h);
  height: var(--control-h);
  padding: 0 22rpx;
  border: 1rpx solid #c8d5cd;
  border-radius: 14rpx;
  background: #fafcfb;
  color: var(--ink);
  font-size: 28rpx;
  line-height: var(--control-h);
}

.input:focus {
  border-color: var(--accent);
  background: #fff;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  height: var(--control-h);
  line-height: 1.4;
  color: var(--ink);
}

.picker-value .picker-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-caret {
  flex: none;
  color: #8a968e;
  font-size: 24rpx;
  line-height: 1;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.list-surface {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #e7efe9;
}

.list-row:last-child {
  border-bottom: 0;
}

.row-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  flex: 1;
}

.row-text {
  min-width: 0;
  flex: 1;
}

.row-title {
  display: block;
  overflow: hidden;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  flex: none;
  color: #9aa89f;
  font-size: 32rpx;
  line-height: 1;
}

.empty-state {
  padding: 76rpx 28rpx;
  color: var(--muted);
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 38rpx;
  font-weight: 700;
}

.empty-icon {
  display: block;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 22rpx;
}

.empty-title {
  display: block;
  margin-top: 18rpx;
  color: #2a3a31;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-copy {
  display: block;
  max-width: 500rpx;
  margin: 10rpx auto 0;
  font-size: 24rpx;
  line-height: 1.55;
}

.error-state {
  padding: 44rpx 28rpx;
  border: 1rpx solid #e3b8b1;
  border-radius: var(--radius);
  background: #fff8f6;
  color: var(--red);
  text-align: center;
}

.safe-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-with-fab {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}
